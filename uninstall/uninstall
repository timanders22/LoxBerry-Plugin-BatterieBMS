#!/bin/bash
# Batterie-Heimspeicher (BMS) - Deinstallation
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Warum es diese Datei gibt (B34, 04.09.2026):
#
# Die Zweitschrift der Konfiguration liegt mit Absicht NEBEN dem
# Konfigurationsordner, als config/plugins/<ordner>.backup.json - nur so
# uebersteht sie ein Upgrade, bei dem der Installer config/plugins/<ordner>/
# abraeumt. Dass sie damit auch die DEINSTALLATION uebersteht, war ein
# Nebeneffekt, keine Absicht:
#
#   1. Nach dem Entfernen des Plugins blieb eine Datei mit dem Aktionstoken
#      und allen Geraeteadressen dauerhaft auf dem Geraet liegen.
#   2. Eine Neuinstallation holte die alte Konfiguration wortlos zurueck. Wer
#      deinstalliert hat, um sauber neu anzufangen, kam daran nicht vorbei -
#      und kein Text sagte ihm, wo die Datei liegt.
#
# Wer seine Einstellungen ueber eine Deinstallation retten will, benutzt den
# Knopf "Einstellungen sichern" im Reiter Einstellungen. Dafuer ist er da.
#
# Das UPGRADE ist davon nicht beruehrt: dort laeuft preupgrade.sh, nicht
# dieses Skript.

ARGV3=$3
PFOLDER="${ARGV3:-batteriebms}"
# Wurzel, in dieser Reihenfolge (Regeln/06: ohne brauchbare Wurzel warnen
# statt vollziehen; dieselbe Regel wie bin/dienst.sh):
#   1. das fuenfte Argument - der Installer uebergibt dort die LoxBerry-Wurzel
#      (plugininstall.pl:1158 und :1577, am Geraet nachgesehen 17.09.2026),
#   2. $LBHOMEDIR, wenn darunter config/plugins und data/plugins liegen,
#   3. vom eigenen Ablageort aufwaerts das erste Verzeichnis mit
#      config/plugins, data/plugins UND config/system/general.json.
# Bauart ZendureSolarFlow 0.9.25/0.9.26.
bm_wurzel_suchen() {
    bm_v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd -P)
    bm_i=0
    while [ -n "$bm_v" ] && [ "$bm_v" != "/" ] && [ "$bm_i" -lt 8 ]; do
        if [ -d "$bm_v/config/plugins" ] && [ -d "$bm_v/data/plugins" ] \
           && [ -f "$bm_v/config/system/general.json" ]; then
            echo "$bm_v"
            return 0
        fi
        bm_v=$(dirname "$bm_v")
        bm_i=$((bm_i + 1))
    done
    return 1
}
BASE="${5:-}"
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    if [ -n "${LBHOMEDIR:-}" ] && [ -d "$LBHOMEDIR/config/plugins" ] \
       && [ -d "$LBHOMEDIR/data/plugins" ]; then
        BASE="$LBHOMEDIR"
    else
        BASE=$(bm_wurzel_suchen) || BASE=""
    fi
fi
# Der Installer legt dieses Skript als <home>/data/system/uninstall/<ordner>
# ab; Stufe 3 findet von dort <home>. Bis 0.9.27 wurden ohne fuenftes
# Argument zwei Ebenen hinauf gerechnet - von dort ist das <home>/data, keine
# Wurzel, und die Zweitschrift mit dem Aktionstoken blieb liegen (Fall K4);
# aus einem Archiv unter / war es die Laufwerkswurzel, und
# /config/plugins/<ordner>.backup.json wurde dort geloescht (Fall K2; beides
# in WSL gemessen, Pruefung-BatterieBMS-0.9.28).
if [ -z "$BASE" ]; then
    echo "<WARNING> Es wurde kein LoxBerry-Wurzelverzeichnis gefunden - nichts beendet, nichts entfernt."
    echo "<WARNING> Liegen bleiben koennen config/plugins/$PFOLDER.backup.json (mit dem"
    echo "<WARNING> Aktionstoken) und zurueckbehaltene MQTT-Themen der Linie."
    exit 1
fi

# 1. Den Dienst anhalten, bevor etwas verschwindet. Er haelt eine
#    Modbus-Verbindung offen, und manche Speicher lassen nur eine zu.
DIENST="$BASE/bin/plugins/$PFOLDER/dienst.sh"
if [ -f "$DIENST" ]; then
    AUSGABE=$(LBHOMEDIR="$BASE" bash "$DIENST" stop 2>&1)
    echo "<INFO> dienst.sh stop: $AUSGABE"
fi

# 1a. Offener Zwang (I4, Durchgang 29.09.2026). Liegt nach dem Anhalten noch
#     eine Sollwertdatei, hat der Dienst einen Zwang NICHT zuruecknehmen
#     koennen. Bis 0.9.29 stand hier danach "<OK> Deinstallation
#     abgeschlossen", und die Protokollzeile kam nicht an (gemessen, Fall d2).
#     Nach der Deinstallation nimmt ihn niemand mehr zurueck - deshalb die
#     <WARNING> mit dem Speichernamen und am Ende kein <OK>.
PDATA="$BASE/data/plugins/$PFOLDER"
CF="$BASE/config/plugins/$PFOLDER/batteriebms.json"
bm_zwang_klartext() {
    set -- "$PDATA"/soll_geraet*.json
    [ -e "$1" ] || return 0
    if command -v php >/dev/null 2>&1; then
        php -r '$g = json_decode((string) @file_get_contents($argv[2]), true); $t = array();
            foreach ((array) glob($argv[1] . "/soll_geraet*.json") as $f) {
                if (!preg_match("/soll_geraet([0-9]{1,3})\.json$/", $f, $m)) { continue; }
                $n = (int) $m[1];
                $s = json_decode((string) @file_get_contents($f), true);
                $name = "";
                if (is_array($s) && isset($s["anschrift"]["name"]) && is_string($s["anschrift"]["name"])) {
                    $name = $s["anschrift"]["name"];
                } elseif (is_array($g) && isset($g["geraete"][$n - 1]["name"]) && is_string($g["geraete"][$n - 1]["name"])) {
                    $name = $g["geraete"][$n - 1]["name"];
                }
                $a = (is_array($s) && isset($s["aktion"]) && is_string($s["aktion"])) ? $s["aktion"] : "?";
                $name = preg_replace("/[\\x00-\\x1F\\x7F]/", "", $name);
                $t[] = ($name !== "" ? $name . " " : "") . "(Speicher " . $n . ", " . $a . ")";
            }
            echo implode(", ", $t);' "$PDATA" "$CF" 2>/dev/null && return 0
    fi
    for f in "$@"; do printf '%s ' "${f##*/}"; done
}
ZWANG_OFFEN=$(bm_zwang_klartext)
if [ -n "$ZWANG_OFFEN" ]; then
    echo "<WARNING> Zwang NICHT zurueckgenommen: $ZWANG_OFFEN. Der Speicher steht moeglicherweise"
    echo "<WARNING> noch im Lade- oder Entladezwang, und nach der Deinstallation nimmt ihn niemand"
    echo "<WARNING> mehr zurueck. Bitte am Geraet (App oder Bedienfeld des Speichers) auf Automatik stellen."
fi

# 1b. Zurueckbehaltene MQTT-Themen der Linie leeren.
#
#    Seit 0.9.17 gehen Zustaende retained hinaus. Bis 0.9.27 blieben sie nach
#    dem Deinstallieren im Broker stehen, und nach jedem Neustart von Broker
#    oder Gateway bekam der Miniserver sie wieder (in WSL gemessen,
#    Pruefung-BatterieBMS-0.9.28, Faelle U1-U6). NACH dem Anhalten des
#    Dienstes - sonst schriebe er die Werte gleich wieder hinein - und VOR dem
#    Loeschen der Ordner durch den Installer (Praefix, Speichernummern und
#    bin/ sind hier noch da). Geleert wird ueber den Weg der Linie, den
#    UDP-Eingang des Gateways, und beim Broker nachgelesen, wo er sich fragen
#    laesst (bm_mqtt_leeren() in webfrontend/html/bm_lib.php). Als loxberry,
#    nicht als root; stdin geschlossen, damit su nie auf eine Eingabe wartet.
#    Bauart ZendureSolarFlow 0.9.26.
BM_DIENST_PHP="$BASE/bin/plugins/$PFOLDER/bms_dienst.php"
if command -v php >/dev/null 2>&1 && [ -f "$BM_DIENST_PHP" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" \
            timeout 60 php "$BM_DIENST_PHP" --mqtt-leeren)" < /dev/null 2>&1 || true
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" timeout 60 php "$BM_DIENST_PHP" --mqtt-leeren \
            < /dev/null 2>&1 || true
    fi
    # M3 (Durchgang 29.09.2026): auch das zuletzt verlassene Praefix, falls
    # die Konfiguration eines vermerkt (mqtt_praefix_alt, beim Praefixwechsel
    # gesetzt). Gelesen wird nur ein Wert, der ins Themenmuster passt.
    ALT_PRAEFIX=$(php -r '$d = json_decode((string) @file_get_contents($argv[1]), true);
        $p = (is_array($d) && isset($d["mqtt_praefix_alt"]) && is_string($d["mqtt_praefix_alt"])) ? $d["mqtt_praefix_alt"] : "";
        echo preg_match("#^[A-Za-z0-9_\-]([A-Za-z0-9_/\-]{0,62}[A-Za-z0-9_\-])?\z#", $p) ? $p : "";' "$CF" 2>/dev/null)
    if [ -n "$ALT_PRAEFIX" ]; then
        echo "<INFO> MQTT: auch das frueher benutzte Praefix $ALT_PRAEFIX/ wird geleert."
        if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
            su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" \
                timeout 60 php "$BM_DIENST_PHP" --mqtt-leeren "--praefix=$ALT_PRAEFIX")" < /dev/null 2>&1 || true
        else
            env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" timeout 60 php "$BM_DIENST_PHP" --mqtt-leeren \
                "--praefix=$ALT_PRAEFIX" < /dev/null 2>&1 || true
        fi
    fi
else
    echo "<INFO> PHP oder bms_dienst.php fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

# 2. Alles entfernen, was NEBEN den Ordnern liegt und deshalb von
#    purge_installation nicht erfasst wird. Jede Datei einzeln benannt -
#    kein Muster, damit hier nie versehentlich etwas Fremdes getroffen wird.
#    I1 (Durchgang 29.09.2026): dazu die .alt-Dateien, die preinstall.sh bei
#    einer Neuinstallation beiseitelegt, und das Bruchstueck .backup.kaputt
#    aus preupgrade.sh (I2).
for DATEI in \
    "$BASE/config/plugins/$PFOLDER.backup.json" \
    "$BASE/config/plugins/$PFOLDER.backup.daten.tar" \
    "$BASE/config/plugins/$PFOLDER.backup.json.alt" \
    "$BASE/config/plugins/$PFOLDER.backup.daten.tar.alt" \
    "$BASE/config/plugins/$PFOLDER.backup.json.kaputt" \
    "$BASE/config/plugins/$PFOLDER.laeuft" \
    "$BASE/data/plugins/$PFOLDER.upgrade_laeuft"
do
    if [ -f "$DATEI" ]; then
        rm -f "$DATEI" && echo "<OK> Entfernt: $(basename "$DATEI")"
    fi
done

echo "<INFO> Die Einstellungen sind damit endgueltig fort. Wer sie behalten"
echo "<INFO> wollte, hat sie vorher ueber 'Einstellungen sichern' als Datei"
echo "<INFO> heruntergeladen und kann sie in einer neuen Installation ueber"
echo "<INFO> 'Einstellungen zurueckspielen' wieder einlesen."
if [ -n "$ZWANG_OFFEN" ]; then
    # I4: kein <OK> - die <WARNING> oben ist die Aussage.
    echo "<INFO> Deinstallation beendet - mit offenem Zwang (siehe <WARNING> oben)."
    exit 0
fi
echo "<OK> Deinstallation abgeschlossen."
exit 0
