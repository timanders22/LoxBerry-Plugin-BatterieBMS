#!/bin/sh
# Batterie-Heimspeicher (BMS) - Waechter, minuetlich (Gruppe 31, 0.9.38, B8).
# Hausform (Regeln/06 :475, :505; Docker NG 1.3.7, Marstek 1.0.17): Fehlerausgabe nach cron.err im
# Protokollordner (Reiter Logdateien), touch frischt die Zeit auf, ab 256 kB die letzten 300 Zeilen.
# bash statt Ausfuehrbarkeitspruefung (B8): das x-Bit setzt der Installer, ein fehlendes Bit
# legte bis 0.9.37 den Waechter still. Die Platzhalter stehen NUR in den drei Zuweisungen
# darunter (B53: der Installer ersetzt sie in der ganzen Datei, auch im Kommentar).
# Als root aufgerufen (von Hand): einmal auf loxberry wechseln, sonst gehoerte cron.err root.
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

WAECHTER="REPLACELBPBINDIR/dienst.sh"
BRUECKE="REPLACELBPBINDIR/befehlsbruecke.sh"
LOGD="REPLACELBPLOGDIR"
if [ "$(id -u)" = "0" ] && command -v su >/dev/null 2>&1; then
    exec su loxberry -s /bin/sh -c "sh '$0'"
fi
ERR="$LOGD/cron.err"
mkdir -p "$LOGD" 2>/dev/null
# 0.9.40 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): touch allein genuegt nicht - es gelingt auch auf einem
# Verzeichnis und, beim Eigentuemer, auf einer schreibgeschuetzten Datei. Bis 0.9.39 brach dann die Umlenkung
# den Befehl ab, BEVOR er startete.
if touch "$ERR" 2>/dev/null && [ -f "$ERR" ] && [ -w "$ERR" ]; then
    if [ "$(stat -c %s "$ERR" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -n 300 "$ERR" > "$ERR.neu" 2>/dev/null && mv -f "$ERR.neu" "$ERR"
    fi
else
    ERR=/dev/null
fi
if [ ! -f "$WAECHTER" ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') Waechter fehlt: $WAECHTER" >> "$ERR"
    exit 0
fi
bash "$WAECHTER" waechter >/dev/null 2>>"$ERR"
if [ -f "$BRUECKE" ]; then
    bash "$BRUECKE" waechter >/dev/null 2>>"$ERR"
fi
exit 0
